# =============================================================================
# Stock Trading Platform — example environment file
# =============================================================================
# Copy this file to `.env`, fill in real values and NEVER commit it:
# `.env` is already listed in .gitignore. Everything below is a placeholder.
#
# The `dev` profile already provides localhost defaults, so this file is only
# needed to override values or to run the `prod` profile.

# -----------------------------------------------------------------------------
# Shared database credentials (every service)
# -----------------------------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=admin

# -----------------------------------------------------------------------------
# user-service (8081)
# -----------------------------------------------------------------------------
USER_SERVICE_PORT=8081
USER_DB_URL=jdbc:mysql://localhost:3306/user_db?createDatabaseIfNotExist=true
# Base64-encoded HMAC key of at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32
# Shared secret accepted by /internal/** endpoints (service-to-service traffic only)
INTERNAL_API_TOKEN=replace-me-with-a-random-token
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=24h

# -----------------------------------------------------------------------------
# market-data-service (8082)
# -----------------------------------------------------------------------------
MARKET_DATA_SERVICE_PORT=8082
MARKET_DB_URL=jdbc:mysql://localhost:3306/market_db?createDatabaseIfNotExist=true
REDIS_HOST=localhost
REDIS_PORT=6379
MARKET_PRICE_UPDATE_INTERVAL=2000

# -----------------------------------------------------------------------------
# order-service (8083)
# -----------------------------------------------------------------------------
ORDER_SERVICE_PORT=8083
ORDER_DB_URL=jdbc:mysql://localhost:3306/order_db?createDatabaseIfNotExist=true
MARKET_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8081
AI_SERVICE_URL=http://localhost:8086

# -----------------------------------------------------------------------------
# portfolio-service (8084)
# -----------------------------------------------------------------------------
PORTFOLIO_SERVICE_PORT=8084
# Still named portfolio_fb; renamed to portfolio_db in Phase 2
PORTFOLIO_DB_URL=jdbc:mysql://localhost:3306/portfolio_fb?createDatabaseIfNotExist=true

# -----------------------------------------------------------------------------
# notification-service (8085)
# -----------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=8085
# Channel: log | email | sms
NOTIFICATION_CHANNEL=log
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATION_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NOTIFICATION_SMS_TO=

# -----------------------------------------------------------------------------
# ai-service (8086)
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8086
AI_PROVIDER=auto
AI_CONSULT_ON_REVIEW=true
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Kafka (KRaft)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# api-gateway (8080)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8080
USER_SERVICE_URI=http://localhost:8081
MARKET_SERVICE_URI=http://localhost:8082
MARKET_SERVICE_WS_URI=ws://localhost:8082
ORDER_SERVICE_URI=http://localhost:8083
PORTFOLIO_SERVICE_URI=http://localhost:8084
NOTIFICATION_SERVICE_URI=http://localhost:8085
AI_SERVICE_URI=http://localhost:8086
